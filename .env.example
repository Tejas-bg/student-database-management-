# NEXUS — Environment Variable Template
# Copy this file to `.env` and replace every placeholder with a local value.
# Never commit the real `.env` file.

FLASK_ENV=development
FLASK_SECRET_KEY=replace-with-a-long-random-secret

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexus

# Application runtime user (least privilege)
DB_USER=nexus_app
DB_PASSWORD=replace-with-a-strong-password

# Schema/migration user
DB_ADMIN_USER=nexus_admin
DB_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Read-only reporting user
DB_REPORT_USER=nexus_report
DB_REPORT_PASSWORD=replace-with-a-strong-report-password
