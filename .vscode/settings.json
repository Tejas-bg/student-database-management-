{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "editor.rulers": [100],
  "editor.formatOnSave": false,
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.venv": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true
  }
}
